local function GetWeaponType(character, backpack)
	local function scan(container)
		for _, item in pairs(container:GetChildren()) do
			if item:IsA("Tool") then
				local name = string.lower(item.Name)
				if string.find(name, "knife") or string.find(name, "sword") or string.find(name, "dagger") or string.find(name, "blade") or string.find(name, "มีด") then
					return "Knife"
				elseif string.find(name, "gun") or string.find(name, "pistol") or string.find(name, "revolver") or string.find(name, "ปืน") then
					return "Gun"
				end
			end
		end
		return nil
	end
	
	local w = scan(character)
	if w then return w end
	if backpack then
		w = scan(backpack)
		if w then return w end
	end
	return "Innocent"
end

local function RemoveTracer(p)
	if getgenv().MM2ESP_Tracers[p] then
		pcall(function()
			getgenv().MM2ESP_Tracers[p]:Remove()
		end)
		getgenv().MM2ESP_Tracers[p] = nil
	end
end

table.insert(getgenv().MM2ESP_Connections, RunService.RenderStepped:Connect(function()
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			local char = p.Character
			local hrp = char.HumanoidRootPart
			local wType = GetWeaponType(char, p:FindFirstChild("Backpack"))
			
			local knifeHigh = char:FindFirstChild("MM2_KnifeESP")
			local gunHigh = char:FindFirstChild("MM2_GunESP")
			local innocentHigh = char:FindFirstChild("MM2_InnocentESP")
			local boxHigh = char:FindFirstChild("MM2_BoxESP")
			
			if GetKnifeState() and wType == "Knife" then
				if not knifeHigh then
					knifeHigh = Instance.new("Highlight")
					knifeHigh.Name = "MM2_KnifeESP"
					knifeHigh.Adornee = char
					knifeHigh.FillColor = Color3.fromRGB(255, 0, 0)
					knifeHigh.OutlineColor = Color3.fromRGB(255, 255, 255)
					knifeHigh.FillTransparency = 0.5
					knifeHigh.Parent = char
				end
			else
				if knifeHigh then knifeHigh:Destroy() end
			end
			
			if GetGunState() and wType == "Gun" then
				if not gunHigh then
					gunHigh = Instance.new("Highlight")
					gunHigh.Name = "MM2_GunESP"
					gunHigh.Adornee = char
					gunHigh.FillColor = Color3.fromRGB(0, 150, 255)
					gunHigh.OutlineColor = Color3.fromRGB(255, 255, 255)
					gunHigh.FillTransparency = 0.5
					gunHigh.Parent = char
				end
			else
				if gunHigh then gunHigh:Destroy() end
			end
			
			if GetInnocentState() and wType == "Innocent" then
				if not innocentHigh then
					innocentHigh = Instance.new("Highlight")
					innocentHigh.Name = "MM2_InnocentESP"
					innocentHigh.Adornee = char
					innocentHigh.FillColor = Color3.fromRGB(0, 255, 0)
					innocentHigh.OutlineColor = Color3.fromRGB(255, 255, 255)
					innocentHigh.FillTransparency = 0.5
					innocentHigh.Parent = char
				end
			else
				if innocentHigh then innocentHigh:Destroy() end
			end
			
			if GetBoxTracerState() then
				if not boxHigh then
					boxHigh = Instance.new("Highlight")
					boxHigh.Name = "MM2_BoxESP"
					boxHigh.Adornee = char
					boxHigh.FillTransparency = 1
					boxHigh.OutlineColor = Color3.fromRGB(255, 255, 255)
					boxHigh.OutlineTransparency = 0
					boxHigh.Parent = char
				end
				
				local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)
				if onScreen then
					if not getgenv().MM2ESP_Tracers[p] then
						local line = Drawing.new("Line")
						line.Visible = true
						line.Color = Color3.fromRGB(255, 255, 255)
						line.Thickness = 1.5
						line.Transparency = 1
						getgenv().MM2ESP_Tracers[p] = line
					end
					getgenv().MM2ESP_Tracers[p].From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
					getgenv().MM2ESP_Tracers[p].To = Vector2.new(vector.X, vector.Y)
					getgenv().MM2ESP_Tracers[p].Visible = true
				else
					if getgenv().MM2ESP_Tracers[p] then getgenv().MM2ESP_Tracers[p].Visible = false end
				end
			else
				if boxHigh then boxHigh:Destroy() end
				RemoveTracer(p)
			end
		else
			local char = p.Character
			if char then
				if char:FindFirstChild("MM2_KnifeESP") then char.MM2_KnifeESP:Destroy() end
				if char:FindFirstChild("MM2_GunESP") then char.MM2_GunESP:Destroy() end
				if char:FindFirstChild("MM2_InnocentESP") then char.MM2_InnocentESP:Destroy() end
				if char:FindFirstChild("MM2_BoxESP") then char.MM2_BoxESP:Destroy() end
			end
			RemoveTracer(p)
		end
	end
end))
