local function CreateToggle(name, posY)
	local ToggleBtn = Instance.new("TextButton")
	ToggleBtn.Size = UDim2.new(1, -15, 0, 35)
	ToggleBtn.Position = UDim2.new(0, 5, 0, posY)
	ToggleBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
	ToggleBtn.Text = name .. ": ปิด"
	ToggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
	ToggleBtn.Font = Enum.Font.GothamBold
	ToggleBtn.TextSize = 12
	ToggleBtn.Parent = ScrollFrame

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 8)
	Corner.Parent = ToggleBtn

	local state = false
	ToggleBtn.MouseButton1Click:Connect(function()
		state = not state
		if state then
			ToggleBtn.Text = name .. ": เปิด"
			ToggleBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
			ToggleBtn.BackgroundColor3 = Color3.fromRGB(25, 50, 25)
		else
			ToggleBtn.Text = name .. ": ปิด"
			ToggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
			ToggleBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
		end
	end)
	
	return ToggleBtn, function() return state end
end

