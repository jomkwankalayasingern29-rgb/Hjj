-- ระบบควบคุมความเร็ว, กระโดด, การบิน (Fly) และ ทะลุกำแพง (Noclip)
local bg, bv
table.insert(getgenv().MM2ESP_Connections, RunService.RenderStepped:Connect(function()
	local char = Player.Character
	if char then
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		local hrp = char:FindFirstChild("HumanoidRootPart")
		
		if humanoid and hrp then
			if GetNoclipState() then
				for _, part in pairs(char:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = false
					end
				end
			end

			local speedVal = tonumber(WalkSpeedBox.Text)
			if speedVal then
				speedVal = math.clamp(speedVal, 1, 200)
				humanoid.WalkSpeed = speedVal
			end
			
			local jumpVal = tonumber(JumpPowerBox.Text)
			if jumpVal then
				jumpVal = math.clamp(jumpVal, 1, 100)
				if humanoid.UseJumpPower then
					humanoid.JumpPower = jumpVal
				else
					humanoid.JumpHeight = jumpVal / 3
				end
			end
			
			if GetFlyState() then
				if not hrp:FindFirstChild("MM2_FlyBodyGyro") then
					bg = Instance.new("BodyGyro")
					bg.Name = "MM2_FlyBodyGyro"
					bg.P = 9e4
					bg.MaxTorque = Vector3.new(9e4, 9e4, 9e4)
					bg.CFrame = hrp.CFrame
					bg.Parent = hrp
				end
				if not hrp:FindFirstChild("MM2_FlyBodyVelocity") then
					bv = Instance.new("BodyVelocity")
					bv.Velocity = Vector3.new(0, 0, 0)
					bv.Name = "MM2_FlyBodyVelocity"
					bv.MaxForce = Vector3.new(9e4, 9e4, 9e4)
					bv.Parent = hrp
				end
				
				humanoid.PlatformStand = true
				
				local direction = Vector3.new()
				if UserInputService:IsKeyDown(Enum.KeyCode.W) then
					direction = direction + Camera.CoordinateFrame.LookVector
				end
				if UserInputService:IsKeyDown(Enum.KeyCode.S) then
					direction = direction - Camera.CoordinateFrame.LookVector
				end
				if UserInputService:IsKeyDown(Enum.KeyCode.A) then
					direction = direction - Camera.CoordinateFrame.RightVector
				end
				if UserInputService:IsKeyDown(Enum.KeyCode.D) then
					direction = direction + Camera.CoordinateFrame.RightVector
				end
				if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
					direction = direction + Vector3.new(0, 1, 0)
				end
				if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
					direction = direction - Vector3.new(0, 1, 0)
				end
				
				if direction.Magnitude > 0 then
					bv.Velocity = direction.Unit * 50
				else
					bv.Velocity = Vector3.new(0, 0.1, 0)
				end
				bg.CFrame = Camera.CoordinateFrame
			else
				if hrp:FindFirstChild("MM2_FlyBodyGyro") then hrp.MM2_FlyBodyGyro:Destroy() end
				if hrp:FindFirstChild("MM2_FlyBodyVelocity") then hrp.MM2_FlyBodyVelocity:Destroy() end
			end
		end
	end
end))

